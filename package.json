{
  "name": "yocim-agent",
  "version": "0.1.4",
  "private": true,
  "description": "YOCIM AGENT - local-first desktop AI coding assistant",
  "main": "./out/main/index.js",
  "author": "YOCIM",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "bench": "vitest run tests/bench --pool=vmThreads",
    "bench:baseline": "npm run bench && node -e \"require('node:fs').copyFileSync('tests/bench/results/last.json', 'tests/bench/results/baseline.json'); console.log('baseline updated')\"",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-vite build",
    "e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.18",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "marked": "^18.2.0",
    "monaco-editor": "^0.57.0",
    "pinia": "^4.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  }
}
